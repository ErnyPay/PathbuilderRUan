<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="true"
        android:label="RuneSheet RU"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name="ru.gran.edge2e.ReferenceCompanionActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.ReferenceCatalogActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.ReferenceItemActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.ReferenceMoreActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.ReferenceBuildActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.ReferencePlayActivity"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.MainActivityV2"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.MainActivityV3"
            android:exported="true"
            android:screenOrientation="portrait" />
        <activity
            android:name="ru.gran.edge2e.FrontPageActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="pathbuilder2e.com" android:path="/launch.html" />
                <data android:scheme="https" android:host="www.pathbuilder2e.com" android:path="/launch.html" />
            </intent-filter>
        </activity>
    </application>
</manifest>
